# 双语字幕生成器 · 用户配置（由 ./docker-start.sh setup 向导自动填写，也可以手工改）
# 改完后重新执行 ./docker-start.sh（会重建容器并生效）。注意 docker compose restart 不会重新读这个文件。

# Gemini API key，多个用逗号分开轮流使用。到 https://aistudio.google.com/apikey 申请。
GOOGLE_API_KEYS=

# 代理。留空 = 直连。容器里访问宿主机的代理软件要写 host.docker.internal 而不是 127.0.0.1，
# 例如 http://host.docker.internal:7890 或 socks5h://host.docker.internal:10808
HTTP_PROXY=
HTTPS_PROXY=
# 这些域名不走代理（B 站上传走国内 CDN，经代理只会更慢或失败）
NO_PROXY=localhost,127.0.0.1,.bilibili.com,.bilivideo.com,.biliapi.net,.hdslb.com,.acgvideo.com

# 高级：让 Gemini 单独走另一条 socks5 路径绕开代理服务端的域名分流（docs/RUNBOOK.md §5.5）。
# 绝大多数人留空。
GEMINI_PROXY=

# 1 = 启动自动搬运（需要 config.json 和 B 站登录），0 = 只用 Web 界面
ENABLE_AUTOMATION=0

# 时区（影响日志时间显示）
TZ=Asia/Tokyo
